{
  "openapi": "3.0.0",
  "info": {
    "title": "Billing Service API",
    "version": "1.0.0",
    "description": "API для управления подписками и платежами"
  },
  "paths": {
    "/subscriptions": {
      "get": {
        "summary": "Получить информацию о текущей подписке",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Информация о подписке",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions/plans": {
      "get": {
        "summary": "Получить доступные тарифные планы",
        "responses": {
          "200": {
            "description": "Список тарифных планов",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SubscriptionPlan"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions/purchase": {
      "post": {
        "summary": "Приобрести подписку",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionPurchase"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Создан платеж",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "402": {
            "description": "Ошибка платежа"
          }
        }
      }
    },
    "/subscriptions/cancel": {
      "post": {
        "summary": "Отменить подписку",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Подписка отменена"
          },
          "400": {
            "description": "Нельзя отменить активную подписку"
          }
        }
      }
    },
    "/admin/subscriptions/{userId}": {
      "put": {
        "summary": "Админ-запрос изменить подписку пользователя",
        "security": [
          {
            "AdminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSubscriptionUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Подписка изменена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Subscription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "enum": [
              "free",
              "basic",
              "premium"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "canceled",
              "pending_payment"
            ]
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "SubscriptionPlan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "float"
          },
          "duration_days": {
            "type": "integer"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SubscriptionPurchase": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string"
          },
          "payment_method": {
            "type": "string",
            "enum": [
              "card",
              "bank_transfer"
            ]
          }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "float"
          },
          "currency": {
            "type": "string",
            "example": "RUB"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed"
            ]
          },
          "payment_url": {
            "type": "string",
            "description": "URL для оплаты"
          }
        }
      },
      "AdminSubscriptionUpdate": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "free",
              "basic",
              "premium"
            ]
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "comment": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "AdminAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Key"
      }
    }
  }
}