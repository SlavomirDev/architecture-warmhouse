{
  "openapi": "3.0.0",
  "info": {
    "title": "Devices Service API",
    "version": "1.0.0",
    "description": "API для управления устройствами и отправки команд"
  },
  "paths": {
    "/devices": {
      "get": {
        "summary": "Получить список устройств пользователя",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Список устройств",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Device"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Зарегистрировать новое устройство",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDeviceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Устройство зарегистрировано",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            }
          }
        }
      }
    },
    "/devices/{deviceId}/command": {
      "post": {
        "summary": "Отправить команду устройству",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCommandRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Команда принята в обработку"
          },
          "403": {
            "description": "Нет доступа к устройству"
          },
          "404": {
            "description": "Устройство не найдено"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "heater",
              "light",
              "gate",
              "camera"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "offline",
              "error"
            ]
          }
        }
      },
      "RegisterDeviceRequest": {
        "type": "object",
        "properties": {
          "locationId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "heater",
              "light",
              "gate",
              "camera"
            ]
          },
          "model": {
            "type": "string"
          }
        }
      },
      "SendCommandRequest": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "example": "turn_on"
          },
          "parameters": {
            "type": "object",
            "example": {
              "temperature": 22
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}